# JWT и порт API
JWT_SECRET="replace-with-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# --- PostgreSQL (DATABASE_URL) ---
#
# Вариант 1 — только база из этого репозитория (порт на хосте 55432, см. docker-compose.yml):
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/coworking?schema=public"
#
# Вариант 2 — отдельный контейнер на стандартном порту 5432:
# docker run -d --name meetinghub-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=coworking -p 5432:5432 postgres:16-alpine
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coworking?schema=public"
#
# Вариант 3 — свой установленный Postgres: подставьте своего пользователя, пароль, хост и имя БД (БД coworking должна существовать).
