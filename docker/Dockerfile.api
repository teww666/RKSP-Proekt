# Сборка API из корня монорепозитория (когда в Railway Root Directory пустой,
# а Dockerfile path = docker/Dockerfile.api).
# Если Root Directory = backend, используйте backend/Dockerfile вместо этого файла.

FROM node:20-alpine
WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY backend/package*.json ./
RUN npm ci

COPY backend/prisma ./prisma
COPY backend/nest-cli.json backend/tsconfig*.json ./
COPY backend/src ./src
COPY backend/scripts ./scripts

RUN chmod +x scripts/start.sh \
  && npx prisma generate \
  && npm run build \
  && test -f dist/main.js

EXPOSE 4000

CMD ["/app/scripts/start.sh"]
